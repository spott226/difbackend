generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN_SERVICIOS_MEDICOS
  MEDICO
  TERAPEUTA
  PSICOLOGIA
  TRABAJO_SOCIAL
  CAJA
  RECEPCION
  SINDIS
  CONSULTA_REPORTES
  CAPTURISTA
  CONSULTA
}

enum Sex {
  FEMENINO
  MASCULINO
  NO_ESPECIFICADO
}

enum ZoneType {
  URBANA
  RURAL
  INDIGENA
  SIN_ESPECIFICAR
}

enum AppointmentStatus {
  POR_PAGAR
  CONFIRMADA
  PAGADA
  BLOQUEADA
  ATENDIDA
  FINALIZADA
  CANCELADA
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  passwordHash String
  role         Role     @default(CAPTURISTA)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
  createdAppointments Appointment[] @relation("CreatedAppointments")
}

model Beneficiary {
  id                 String    @id @default(uuid())
  snsId              String    @unique
  solucionesId       String    @unique
  curp               String    @unique
  firstName          String
  paternalLastName   String
  maternalLastName   String?
  birthDate          DateTime
  openedAt           DateTime  @default(now())
  sex                Sex
  occupation         String?
  birthPlace         String?
  email              String?
  maritalStatus      String?
  educationLevel     String?
  phone              String?
  works              Boolean   @default(false)
  headOfFamily       Boolean   @default(false)
  photoPath          String?
  signatureData      String?   @db.Text
  emergencyTokenHash String    @unique
  emergencyTokenLast4 String
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  address            Address?
  emergencyContacts  EmergencyContact[]
  disabilityProfile  DisabilityProfile?
  clinicalProfile    ClinicalProfile?
  socioeconomicStudy SocioeconomicStudy?
  psychologyNotes    PsychologyNote[]
  kardexEntries      KardexEntry[]
  supports           Support[]
  appointments        Appointment[]
}

model MedicalService {
  id          String   @id @default(uuid())
  legacyId    Int?     @unique
  name        String   @unique
  description String?
  specialtyLegacyId Int?
  prices      Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  appointments Appointment[]
}

model MedicalStaff {
  id            String   @id @default(uuid())
  legacyStaffId Int?     @unique
  legacyUserId  Int?
  username      String?
  displayName   String
  position      String?
  specialty     String
  specialtyLegacyId Int?
  secondarySpecialty String?
  secondarySpecialtyLegacyId Int?
  professionalId String?
  room          String?
  shift         String?
  shiftLegacyId Int?
  workDays      Json?
  assignsAppointments Boolean @default(true)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  appointments  Appointment[]
}

model MedicationCatalog {
  id          String   @id @default(uuid())
  legacyId    Int?     @unique
  name        String
  presentation String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model CashItem {
  id          String   @id @default(uuid())
  legacyPriceId Int?   @unique
  legacyArticleId Int?
  name        String
  category    String?
  price       Decimal? @db.Decimal(12, 2)
  unitPrice   Decimal? @db.Decimal(12, 2)
  source      String?
  specialtyLegacyId Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([specialtyLegacyId])
}

model Appointment {
  id              String            @id @default(uuid())
  beneficiaryId   String
  serviceId       String
  doctorId        String
  createdByUserId String?
  appointmentDate DateTime
  appointmentTime String
  room            String?
  reason          String
  status          AppointmentStatus @default(POR_PAGAR)
  notes           String?
  legacyId        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  beneficiary     Beneficiary       @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  service         MedicalService    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  doctor          MedicalStaff      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy       User?             @relation("CreatedAppointments", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([doctorId, appointmentDate, appointmentTime])
  @@index([appointmentDate])
  @@index([beneficiaryId])
  @@index([doctorId])
  @@index([status])
}

model Address {
  id            String    @id @default(uuid())
  beneficiaryId String    @unique
  state         String    @default("Aguascalientes")
  municipality  String
  locality      String
  neighborhood  String?
  postalCode    String?
  street        String
  extNumber     String?
  intNumber     String?
  housingType   String?
  zoneType      ZoneType  @default(SIN_ESPECIFICAR)
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id            String      @id @default(uuid())
  beneficiaryId String
  name          String
  relationship  String
  phone         String
  priority      Int         @default(1)
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model DisabilityProfile {
  id              String      @id @default(uuid())
  beneficiaryId   String      @unique
  disabilityType  String
  medicalDiagnosis String
  cause           String?
  doctorNotes     String?
  functionalLevel String?
  beneficiary     Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model ClinicalProfile {
  id              String      @id @default(uuid())
  beneficiaryId   String      @unique
  bloodType       String?
  healthCoverage  String?
  medicalService  String?
  medicalServiceOther String?
  allergies       String?
  medications     String?
  chronicDiseases String?
  emergencyNotes  String?
  beneficiary     Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model SocioeconomicStudy {
  id             String      @id @default(uuid())
  beneficiaryId  String      @unique
  householdIncome Decimal?   @db.Decimal(12, 2)
  dependents     Int?
  housingStatus  String?
  services       String?
  familyType      String?
  incomeType      String?
  rentAmount      Decimal?   @db.Decimal(12, 2)
  yearsInHome     Int?
  bedrooms        Int?
  bathrooms       Int?
  floors          Int?
  roofMaterial    String?
  floorMaterial   String?
  wallMaterial    String?
  hygiene         String?
  movableAssets   Json?
  basicServices   Json?
  incomeDetails   Json?
  expenseDetails  Json?
  familyMembers   Json?
  foodFrequency   Json?
  healthDiagnosis String?
  motivation      String?
  difReason       String?
  institution     String?
  resolutionDate  DateTime?
  officeDate      DateTime?
  finalDiagnosis  String?
  summary        String?
  beneficiary    Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model PsychologyNote {
  id            String      @id @default(uuid())
  beneficiaryId String
  note          String
  createdAt     DateTime    @default(now())
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model KardexEntry {
  id            String      @id @default(uuid())
  beneficiaryId String
  title         String
  detail        String
  createdAt     DateTime    @default(now())
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model Support {
  id            String      @id @default(uuid())
  beneficiaryId String
  name          String
  institution   String?
  notes         String?
  deliveredAt   DateTime?
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model CatalogMunicipality {
  id          String @id @default(uuid())
  name        String @unique
  localities  CatalogLocality[]
}

model CatalogLocality {
  id             String @id @default(uuid())
  municipalityId String
  name           String
  zoneType       ZoneType @default(SIN_ESPECIFICAR)
  municipality   CatalogMunicipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@unique([municipalityId, name])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
